---
import ProjectCard from '../components/ProjectCard.astro';
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
        <link rel="stylesheet" href="/src/styles/global.css" />
		<title>Home</title>
	</head>
	<body>
        <div class="content">
            <h1>Mathematics/Physics</h1>
            <div class="grid">
                <ProjectCard
                    title="Roblox Game Optimization (WIP)"
                    image="/images/roblox.png"
                    description="A modular Python-based simulation tool using discrete probability theory and non-stationary stochastic modeling to optimize player builds and analyze rare event distributions. Supplemented the project with an AutoHotkey automation script to optimize resource loops in high-attention game modes. GitHub is gatekept to the guild, email if interested. Possibility of UI being implemented soon."
                    tags={["python", "sql", "ahk"]}
                />
            </div>

            <div class="grid">
                <ProjectCard
                    title="Dimensions of the Irreps of Sn"
                    image="/images/drp.jpg"
                    description="For the 2025 UChicago Mathematics DRP, I had the privilege of studying the irreducible representations of the symmetric group for general n under Kevin Lin. In the fall, I presented my findings to fellow DRP students. I started with introducing basic concepts in representation theory, and then I displayed the uses of the Young tableaux and the hook length formula."
                />
            </div>

            <div class="grid">
                <ProjectCard
                    title="Jet Reconstruction Algorithm Optimization"
                    description="Under the guidance of Professor David Miller and Graduate Student Mark Larson, I assisted with optimizing Vitis HLS code during the summer of 2025. In this time period, I quickly adapted to coding in Vitis HLS, studied HLS pragmas, wrote custom TCL scripts to run the same code under different pragmas, collected and displayed data using Jupyter Notebook, and wrote a 14-page documentation for future undergraduates working under David Miller."
                    tags={["c", "vitis hls", "vhdl", "tcl"]}
                />
            </div>

            <div class="grid">
                <ProjectCard
                    title="Inverted Pendulum Stabilization"
                    image="/images/pid.png"
                    description="A visualization of inverted pendulum motion with stabilization achieved through PID."
                    tags={["python", "jupyter"]}
                    links={[{url: "https://github.com/esan0983/PID-Inverted-Pendulum", label: "GitHub", icon:"github"}]}
                />
            </div>

            <div class="grid">
                <ProjectCard
                    title="Rips Complex Visualization"
                    image="/images/rips.png"
                    description="A supplementary visualization of the Rips complex for my topological data analysis project."
                    tags={["python"]}
                    links={[{url: "https://github.com/esan0983/ripsvisualization", label: "GitHub", icon:"github"}]}
                />
            </div>

            <div class="grid">
                <ProjectCard
                    title="Persistent Homology"
                    image="/images/reu.png"
                    description="For the 2023 UChicago Mathematics REU, I wrote an expository paper about topological data analysis, particularly the persistence of simple homeomorphic shapes."
                    tags={["python"]}
                    links={[{url: "http://math.uchicago.edu/~may/REU2023/REUPapers/Santos.pdf",label:"Paper", icon:"paper" }, {url: "https://github.com/esan0983/phcalculations", label: "GitHub", icon:"github"}]}
                />
            </div>

            <style>
                .grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
                    gap: 1.5rem;
                    padding: 2rem;
                }
            </style>
        </div>
	</body>
</html>
