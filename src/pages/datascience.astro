---
import ProjectCard from '../components/ProjectCard.astro';
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
        <link rel="stylesheet" href="/src/styles/global.css" />
		<title>Data Science</title>
	</head>
	<body>
        <div class="content">
            <h1>Data Science</h1>
                <div class="grid">
                    <ProjectCard
                        title="Fantasy Anime League Bot"
                        description="A data science project consisting of two models: Model A uses data collected from Tenrai API calls to predict anime rankings for the Fall 2026 season. An end-to-end data pipeline was implemented from ETL all the way to machine learning. Model B uses Kalman Filters to forecast anime success mid-season."
                        tags={["python", "jupyter"]}
                        links={[{url: "https://github.com/esan0983/FAL-Destroyer-3000", label:"GitHub", icon: "github"}]}
                    />

                    <ProjectCard
                        title="CSGO Ranked Analytics"
                        image="/images/db_screenshot.png"
                        description="An end-to-end analytics pipeline involving a dataset of over 950,000 damage events in CS:GO ranked, studying trends of player behavior across ranks. An XGBoost model is used to predict player rank from damage entries."
                        tags={["python", "sql", "jupyter", "tableau"]}
                        links={[{url: "https://github.com/esan0983/CSGO-Ranked-Match-Analysis", label:"GitHub", icon: "github"}]}
                    />

                    <ProjectCard
                        title="Solar Geoengineering Survey Experiment"
                        image="/images/solar.png"
                        description="Investigated the moral hazard of solar geoengineering using a pre-registered experiment (N=2,509). Results show that balanced geoengineering information does not suppress public support for decarbonization, suggesting research can proceed without undermining broader climate action."
                        tags={["r", "qualtrics"]}
                        links={[{url: "https://www.cambridge.org/core/journals/journal-of-experimental-political-science/article/balanced-messaging-about-solar-geoengineering-does-not-reduce-average-support-for-emissions-reductions/1BD6872E981BAC46EB4394BF4FA0B163", label:"Paper", icon: "paper"}]}
                    />
                </div>

                <style>
                    .grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                        gap: 1.5rem;
                        padding: 2rem;
                    }

                    @media (min-width: 1400px) {
                        .grid {
                        grid-template-columns: repeat(4, 1fr);
                        }
                    }

                    @media (min-width: 1000px) and (max-width: 1399px) {
                        .grid {
                        grid-template-columns: repeat(3, 1fr);
                        }
                    }
                </style>
        </div>
		
	</body>
</html>
